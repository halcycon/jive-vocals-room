# Ubuntu 24.04 toolchain for the StudioLive Mac mini target (glibc 2.39).
# Binaries built on the Fedora image may need a newer glibc than the mini has.
# Source is bind-mounted at runtime; this image only carries compilers and headers.
FROM docker.io/library/ubuntu:24.04

ARG GO_SERIES=go1.26.

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        g++ \
        gcc \
        git \
        jq \
        just \
        libjack-jackd2-dev \
        libpipewire-0.3-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && GOV=$(curl -fsSL 'https://go.dev/dl/?mode=json&include=all' \
        | jq -r --arg s "$GO_SERIES" '[.[] | select(.stable and (.version | startswith($s)))][0].version') \
    && test -n "$GOV" && test "$GOV" != null \
    && curl -fsSL "https://go.dev/dl/${GOV}.linux-amd64.tar.gz" | tar -C /usr/local -xz \
    && /usr/local/go/bin/go version \
    && pkg-config --modversion jack \
    && ldd --version | head -1

ENV PATH=/usr/local/go/bin:$PATH \
    CGO_ENABLED=1 \
    GOTOOLCHAIN=local \
    CGO_CFLAGS_ALLOW="-fno-strict-overflow|-fno-strict-aliasing|-D_REENTRANT"

WORKDIR /workspace
