[Unit]
Description=StudioLive FFADO JACK Server
After=network.target
Before=studiolive-osclive.service

[Service]
Type=simple
User=mixer
Group=audio
SupplementaryGroups=audio
LimitRTPRIO=95
LimitMEMLOCK=infinity
Nice=-10
ExecStartPre=/sbin/modprobe -r snd_dice
ExecStart=/usr/bin/jackd -d firewire -r 44100 -p 1024 -n 3
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
